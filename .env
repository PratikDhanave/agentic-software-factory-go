# LLM Provider Configuration (Model-Agnostic)
# Supported providers: "claude", "openai", "ollama", "mock"

LLM_PROVIDER=mock
# LLM_PROVIDER=claude
# LLM_PROVIDER=openai  
# LLM_PROVIDER=ollama

# Provider-specific API Keys
CLAUDE_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# Provider-specific Model Names
CLAUDE_MODEL=claude-3-5-sonnet-20241022
OPENAI_MODEL=gpt-4-turbo
OLLAMA_MODEL=llama2
# OLLAMA_MODEL=mistral
# OLLAMA_MODEL=neural-chat

# Local provider endpoints
OLLAMA_BASE_URL=http://localhost:11434

# GitHub Configuration
GITHUB_WEBHOOK_SECRET=test_webhook_secret
GITHUB_TOKEN=ghp_your_github_token_here

# Database Configuration
DATABASE_URL=postgresql://localhost/factory?sslmode=disable

# Server Configuration
PORT=8000
LOG_LEVEL=debug

# Factory Phase Configuration
FACTORY_PHASE=walk
APPROVAL_THRESHOLD=0.90
LEARNING_WINDOW=100

# Web UI Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
