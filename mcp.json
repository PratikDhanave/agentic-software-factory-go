{
  "name": "agentic-software-factory",
  "version": "1.0.0",
  "description": "MCP server for GitHub automation and issue triage",
  "author": "Pratik Dhanave",
  "license": "MIT",
  "tools": [
    {
      "name": "get_issue",
      "description": "Fetch GitHub issue details including title, body, labels, and state",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "GitHub repository owner/username"
          },
          "repo": {
            "type": "string",
            "description": "GitHub repository name"
          },
          "issue": {
            "type": "number",
            "description": "Issue number"
          }
        },
        "required": ["owner", "repo", "issue"]
      }
    },
    {
      "name": "create_issue",
      "description": "Create a new GitHub issue",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "GitHub repository owner/username"
          },
          "repo": {
            "type": "string",
            "description": "GitHub repository name"
          },
          "title": {
            "type": "string",
            "description": "Issue title"
          },
          "body": {
            "type": "string",
            "description": "Issue body/description"
          }
        },
        "required": ["owner", "repo", "title"]
      }
    },
    {
      "name": "add_labels",
      "description": "Add labels to a GitHub issue",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "GitHub repository owner/username"
          },
          "repo": {
            "type": "string",
            "description": "GitHub repository name"
          },
          "issue": {
            "type": "number",
            "description": "Issue number"
          },
          "labels": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Labels to add"
          }
        },
        "required": ["owner", "repo", "issue", "labels"]
      }
    },
    {
      "name": "post_comment",
      "description": "Post a comment on a GitHub issue",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "GitHub repository owner/username"
          },
          "repo": {
            "type": "string",
            "description": "GitHub repository name"
          },
          "issue": {
            "type": "number",
            "description": "Issue number"
          },
          "body": {
            "type": "string",
            "description": "Comment body"
          }
        },
        "required": ["owner", "repo", "issue", "body"]
      }
    },
    {
      "name": "create_pr",
      "description": "Create a pull request on GitHub",
      "inputSchema": {
        "type": "object",
        "properties": {
          "owner": {
            "type": "string",
            "description": "GitHub repository owner/username"
          },
          "repo": {
            "type": "string",
            "description": "GitHub repository name"
          },
          "title": {
            "type": "string",
            "description": "Pull request title"
          },
          "body": {
            "type": "string",
            "description": "Pull request body/description"
          },
          "head": {
            "type": "string",
            "description": "Branch name with changes"
          },
          "base": {
            "type": "string",
            "description": "Target branch (default: main)"
          }
        },
        "required": ["owner", "repo", "title", "head"]
      }
    }
  ],
  "resources": [],
  "prompts": [],
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false
  }
}
